<?xml version="1.0" encoding="UTF-8"?>
<!--
    Pruebas de integración: necesitan WordPress cargado y se ejecutan dentro del
    contenedor `tests-cli` de wp-env. Van en su propia configuración para que la
    suite unitaria siga corriendo en cualquier sitio, sin Docker y en segundos.
-->
<phpunit
    bootstrap="tests/integration/bootstrap.php"
    backupGlobals="false"
    colors="true"
>
    <coverage>
        <include>
            <directory suffix=".php">includes</directory>
            <directory suffix=".php">admin</directory>
        </include>
        <!--
            La librería vendorizada no es código de este plugin y además nunca
            se ejecuta aquí: cuando hay `vendor/`, quien declara esas clases es
            el autoload de Composer, así que esta copia se contaba entera como
            no cubierta y hundía la cifra sin que hubiera nada que probar.
            Queda fuera igual que en `.phpcs.xml.dist`.
        -->
        <exclude>
            <directory suffix=".php">includes/vendor</directory>
        </exclude>
    </coverage>

    <testsuites>
        <testsuite name="WP AutoFirma (integración)">
            <directory suffix="Test.php">tests/integration</directory>
        </testsuite>
    </testsuites>
</phpunit>
