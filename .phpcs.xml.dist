<?xml version="1.0"?>
<ruleset name="WP AutoFirma">
    <description>WordPress Coding Standards, sin adaptaciones.</description>

    <file>wp-autofirma.php</file>
    <file>admin</file>
    <file>includes</file>
    <file>tests/php</file>
    <file>tests/integration</file>

    <arg name="colors"/>
    <arg value="sp"/>

    <exclude-pattern>vendor/*</exclude-pattern>
    <!-- Librería de terceros vendorizada tal cual para que viaje en el paquete:
         no sigue las convenciones de WordPress ni debe hacerlo. -->
    <exclude-pattern>includes/vendor/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>

    <!-- Comprueba que el código corre de verdad en el PHP mínimo que declara el
         plugin. Mantener testVersion en línea con "Requires PHP" de
         wp-autofirma.php y readme.txt, y con la matriz de PHP de la CI. -->
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress"/>

    <!-- Las pruebas siguen las convenciones de PHPUnit: el nombre del fichero
         debe coincidir con el de la clase para que el autoload la encuentre, y
         bootstrap.php no es un fichero de plugin. -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting.FileComment">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Las pruebas corren sin WordPress cargado, así que no pueden usar sus
         envoltorios del sistema de ficheros ni sus funciones de red: leen y
         escriben con las de PHP a propósito. -->
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
