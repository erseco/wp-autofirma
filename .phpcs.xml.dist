<?xml version="1.0"?>
<ruleset name="WP AutoFirma">
    <description>WordPress Coding Standards adaptados a indentación con espacios.</description>

    <file>wp-autofirma.php</file>
    <file>admin</file>
    <file>includes</file>
    <file>tests/php</file>

    <arg name="colors"/>
    <arg value="sp"/>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>

    <rule ref="WordPress">
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
        <exclude name="Universal.WhiteSpace.DisallowInlineTabs"/>
    </rule>
    <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>

    <!-- Las pruebas siguen las convenciones de PHPUnit: el nombre del fichero
         debe coincidir con el de la clase para que el autoload la encuentre, y
         bootstrap.php no es un fichero de plugin. -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting.FileComment">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Las pruebas corren sin WordPress cargado, así que no pueden usar sus
         envoltorios del sistema de ficheros ni sus funciones de red: leen y
         escriben con las de PHP a propósito. -->
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
