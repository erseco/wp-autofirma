{
  "name": "wp-autofirma",
  "version": "0.1.0",
  "private": true,
  "description": "Integración de AutoFirma con la biblioteca de medios de WordPress",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erseco/wp-autofirma.git"
  },
  "scripts": {
    "build": "esbuild assets/js/admin.js --bundle --format=iife --global-name=WPAutoFirmaAdmin --outfile=build/admin.js --sourcemap && cp node_modules/@erseco/autofirma-client/vendor/autoscript.js build/autoscript.js",
    "check": "npm run format:check && npm run test:js && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "bash scripts/package.sh",
    "test:js": "vitest run --coverage"
  },
  "dependencies": {
    "@erseco/autofirma-client": "^1.9.3-canary.20260801091023.5ea9a84"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "@wordpress/env": "^11.12.0",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "vitest": "^4.1.10"
  }
}
