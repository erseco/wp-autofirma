# Normalización de finales de línea en cada checkout.
* text=auto eol=lf

# Librería de terceros copiada tal cual de upstream por el post-install-cmd de
# Composer. Sin esta excepción, la normalización de arriba la reescribiría en
# cuanto upstream trajera un fichero con CRLF, y la copia dejaría de ser
# idéntica al original.
includes/vendor/** -text

# Nada de lo que sigue alimenta el ZIP distribuible. Ese paquete lo construye
# `wp dist-archive` y su lista de exclusiones es .distignore, la única fuente de
# verdad sobre qué se publica.
#
# Estas reglas solo dan forma al ZIP de código fuente que GitHub sirve en
# archive/refs/heads/*.zip, el que blueprint.json instala en WordPress
# Playground. Conviene que la lista sea corta y no un espejo de .distignore: lo
# que git no versiona (node_modules/, vendor/, dist/, coverage/) nunca llega a un
# `git archive`.
/.agents        export-ignore
/.claude        export-ignore
/.github        export-ignore
/.gitattributes export-ignore
/docs           export-ignore
/tests          export-ignore
