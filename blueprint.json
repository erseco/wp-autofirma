{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "siteOptions": {
    "blogname": "Demostración de WP AutoFirma"
  },
  "landingPage": "/wp-admin/upload.php?page=wp-autofirma-sign",
  "login": true,
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "setSiteLanguage",
      "language": "es_ES"
    },
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_AUTOFIRMA_DEMO_MODE": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/erseco/wp-autofirma",
        "ref": "main",
        "refType": "refname"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; $data = base64_decode('', true); $upload = wp_upload_bits('ejemplo-autofirma.pdf', null, $data); $id = wp_insert_attachment(array('post_mime_type' => 'application/pdf', 'post_title' => 'Ejemplo AutoFirma', 'post_status' => 'inherit'), $upload['file']); update_option('wp_autofirma_demo_attachment_id', $id); ?>"
    }
  ]
}
